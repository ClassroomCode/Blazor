@page "/customer/{CustomerId}/edit"
@rendermode InteractiveServer
@inject NorthwindContext Db
@inject NavigationManager NavigationManager

<PageTitle>Edit Customer</PageTitle>

<h1>Edit Customer</h1>

@if (!found)
{
    <p><em>Customer not found.</em></p>
}
else if (customer is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p role="status">Current count:@currentCount</p>
    <button class="btn btn-primary" @onclick="IncrementCount">Click me</button>
    <p></p>
    <p>Render count:@renderCount</p>
    <p>ParamSet count:@paramSetCount</p>

    <EditForm Model="customer" OnValidSubmit="HandleValidSubmit" FormName="EditCustomerForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Customer ID</label>
            <InputText class="form-control" @bind-Value="customer.CustomerID" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Company Name</label>
            <InputText class="form-control" @bind-Value="customer.CompanyName" />
        </div>

        <div class="mb-3">
            <label class="form-label">Contact Name</label>
            <InputText class="form-control" @bind-Value="customer.ContactName" />
        </div>

        <div class="mb-3">
            <label class="form-label">Contact Title</label>
            <InputText class="form-control" @bind-Value="customer.ContactTitle" />
        </div>

        <div class="mb-3">
            <label class="form-label">Address</label>
            <InputText class="form-control" @bind-Value="customer.Address" />
        </div>

        <div class="mb-3">
            <label class="form-label">City</label>
            <InputText class="form-control" @bind-Value="customer.City" />
        </div>

        <div class="mb-3">
            <label class="form-label">Region</label>
            <InputText class="form-control" @bind-Value="customer.Region" />
        </div>

        <div class="mb-3">
            <label class="form-label">Postal Code</label>
            <InputText class="form-control" @bind-Value="customer.PostalCode" />
        </div>

        <div class="mb-3">
            <label class="form-label">Country</label>
            <InputText class="form-control" @bind-Value="customer.Country" />
        </div>

        <div class="mb-3">
            <label class="form-label">Phone</label>
            <InputText class="form-control" @bind-Value="customer.Phone" />
        </div>

        <div class="mb-3">
            <label class="form-label">Fax</label>
            <InputText class="form-control" @bind-Value="customer.Fax" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@code {
    [Parameter]
    public string CustomerId { get; set; } = string.Empty;

    private Customer? customer;
    private bool found = true;
    private string? errorMessage;

    private int renderCount = 0;
    private int paramSetCount = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        renderCount++;
    }

    protected override async Task OnParametersSetAsync()
    {
        paramSetCount++;

        await Task.Delay(1000);

        customer = await Db.Customers.FindAsync(CustomerId);
        found = customer is not null;
    }

    private async Task HandleValidSubmit()
    {
        errorMessage = null;
        try
        {
            await Db.SaveChangesAsync();
            NavigationManager.NavigateTo("/");
        }
        catch (Exception)
        {
            errorMessage = "An error occurred while saving the customer.";
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/");
    }

    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
